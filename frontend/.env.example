# Same-origin in development; Vite proxies /api to the local backend.
VITE_API_URL=/api
# Optional overrides. Defaults allow for Vercel Python cold starts and email delivery.
VITE_API_TIMEOUT_MS=20000
VITE_EMAIL_TIMEOUT_MS=30000
# Set to true only after Google OAuth is configured on the backend.
VITE_GOOGLE_AUTH_ENABLED=false
