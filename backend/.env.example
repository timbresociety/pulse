# --- Database ---
DATABASE_URL=postgresql+asyncpg://pulse:pulse@localhost:5432/pulse
# Small, stale-connection-safe pool defaults for serverless deployments.
DATABASE_POOL_SIZE=2
DATABASE_MAX_OVERFLOW=1
DATABASE_POOL_TIMEOUT_SECONDS=10
DATABASE_POOL_RECYCLE_SECONDS=300
DATABASE_READINESS_TIMEOUT_SECONDS=5

# --- Auth / sessions ---
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRE_MINUTES=43200

# Google OAuth (create credentials at https://console.cloud.google.com/apis/credentials)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Where Google redirects back after login (must match the console config)
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback

# Where the backend sends the user after a successful login (the PWA)
FRONTEND_URL=http://localhost:5173

# --- Legacy LLM market generation (optional) ---
# This is never used for pulse_poll_v0. It remains only for legacy compatibility.
ANTHROPIC_API_KEY=
LLM_MODEL=claude-opus-4-8
# Generate more markets for a category when a user's unanswered count drops below this
FEED_TOPUP_THRESHOLD=8
# How many markets to generate per category per top-up
FEED_TOPUP_BATCH=10

# --- Dev ---
# When true, enables unverified email sign-in for prototype testers.
EMAIL_LOGIN_ENABLED=true

# One-time email codes. Production enables this method only when Resend or SMTP
# delivery is configured. Local DEBUG mode returns the code in the API response.
OTP_EMAIL_ENABLED=true
OTP_EXPIRE_MINUTES=10
OTP_RESEND_SECONDS=60
OTP_MAX_ATTEMPTS=5
OTP_PEPPER=
OTP_FROM_EMAIL=Pulse <onboarding@resend.dev>
# Recommended cloud delivery option:
RESEND_API_KEY=
# Or use any SMTP provider:
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_STARTTLS=true
SMTP_USE_SSL=false

# When true, enables local gameplay controls and the legacy /auth/dev-login endpoint.
DEBUG=true

# Keep true locally and for a newly provisioned database. Set false after the
# production schema has been migrated; the catalog seed is always idempotent.
INITIALIZE_DATABASE=true
# Keep true locally. After the production catalog has been seeded once, set
# false so serverless cold starts do not repeat the catalog upsert.
SEED_DATABASE=true

# --- Game tuning (all optional; defaults in config.py) ---
REVEAL_START_SECONDS=30
REVEAL_INCREMENT_SECONDS=30
STARTING_BALANCE_CENTS=1000000
STARTING_PULSE_SCORE=1000
