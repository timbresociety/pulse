# --- Database ---
# Use a managed Postgres database in production. Local Docker defaults work for development.
DATABASE_URL=postgresql+asyncpg://pulse:pulse@localhost:5432/pulse

# --- Auth / sessions ---
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRE_MINUTES=43200

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback

# Passwordless email sign-in
# Production: EMAIL_DELIVERY=resend with a valid RESEND_API_KEY.
# Local-only: EMAIL_DELIVERY=console with DEBUG=true writes the code to backend logs.
EMAIL_DELIVERY=resend
RESEND_API_KEY=
EMAIL_FROM="Pulse <signin@example.com>"
EMAIL_LOGIN_TTL_MINUTES=15
EMAIL_LOGIN_MAX_REQUESTS_PER_WINDOW=5

# Admin allowlist
ADMIN_EMAILS=luckyloot786@gmail.com

# Public URLs
FRONTEND_URL=http://localhost:5173
PUBLIC_API_URL=http://localhost:8000
# Optional comma-separated extra frontend origins, for example a production
# frontend plus a preview domain.
CORS_ORIGINS=

# --- Market settings ---
DEFAULT_MARKET_DURATION_MINUTES=1440
STARTING_COINS=100
LEADERBOARD_RANK_METRIC=coins

# Dynamic prompt generation is intentionally inert unless it can provide a
# validated source-bound answer universe.
ANTHROPIC_API_KEY=
LLM_MODEL=claude-opus-4-8
FEED_TOPUP_THRESHOLD=8
FEED_TOPUP_BATCH=10

# --- Dev ---
DEBUG=true
