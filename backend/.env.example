# --- Database ---
DATABASE_URL=postgresql+asyncpg://pulse:pulse@localhost:5432/pulse

# --- Auth / sessions ---
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRE_MINUTES=43200

# Google OAuth (create credentials at https://console.cloud.google.com/apis/credentials)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Where Google redirects back after login (must match the console config)
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback

# Where the backend sends the user after a successful login (the PWA)
FRONTEND_URL=http://localhost:5173

# --- LLM market generation (optional) ---
# Get a key at https://console.anthropic.com/. If unset, the feed falls back to
# the ~60 pre-seeded markets and on-the-fly generation is disabled.
ANTHROPIC_API_KEY=
LLM_MODEL=claude-opus-4-8
# Generate more markets for a category when a user's unanswered count drops below this
FEED_TOPUP_THRESHOLD=8
# How many markets to generate per category per top-up
FEED_TOPUP_BATCH=10

# --- Dev ---
# When true, enables unverified email sign-in for prototype testers.
EMAIL_LOGIN_ENABLED=true

# When true, also enables the legacy /auth/dev-login local-only endpoint.
DEBUG=true

# --- Game tuning (all optional; defaults in config.py) ---
REVEAL_START_SECONDS=30
REVEAL_INCREMENT_SECONDS=30
WIN_PROBABILITY=0.65
NO_BACK_TO_BACK_LOSS_WINDOW=5
FIRST_MARKET_ALWAYS_WIN=true
STARTING_COINS=100
BASE_COIN_PAYOUT=50
LEADERBOARD_RANK_METRIC=coins
